# --- required in production ---
SESSION_SECRET=change-me-to-a-long-random-string
ANTHROPIC_API_KEY=sk-ant-...
PUBLIC_URL=https://api.bemore.app          # this server, reachable by Twilio
APP_URL=https://bemore.app                 # the web app (CORS + push links)
DB_PATH=./data/bemore.sqlite

# --- push notifications (npm run vapid to generate) ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:hello@bemore.app

# --- real phone calls + SMS sign-in (optional; simulated when unset) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SID=                         # Verify service for OTP sign-in
TWILIO_FROM_NUMBER=+44...                  # the number your coach calls from

# --- coach voices (optional; browser speech when unset) ---
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL=eleven_flash_v2_5
TTS_COST_PER_1M_USD=40                     # for the cost log; ElevenLabs Flash API list price
TTS_USER_DAILY_CHARS=15000                 # per-user cap (~50 coach turns); browser speech beyond it
TTS_GLOBAL_DAILY_CHARS=1000000             # all users, per day
TTS_MONTHLY_BUDGET_USD=100                 # all users, per calendar month

# --- development ---
DEV_OTP=123456                             # accepted sign-in code when Twilio Verify is off
